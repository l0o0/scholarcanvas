{
  "name": "@zotero-markdown/whiteboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Isolated React + Vite research whiteboard (xyflow canvas, custom nodes).",
  "exports": {
    ".": "./src/index.ts",
    "./model": "./src/model/index.ts",
    "./nodes": "./src/nodes/index.ts"
  },
  "scripts": {
    "dev": "pnpm --filter @zotero-plugin/fake-zotero build && vite",
    "build": "pnpm --filter @zotero-plugin/fake-zotero build && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.3",
    "html-to-image": "1.11.11",
    "react": "^19.2.8",
    "react-colorful": "5.8.1",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@zotero-plugin/fake-zotero": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^6.0.3",
    "vite": "^5.4.8"
  }
}
